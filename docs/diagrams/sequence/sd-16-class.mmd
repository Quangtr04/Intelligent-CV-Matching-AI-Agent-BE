        <<service>>
        +createDraft(UUID jobId, DraftRequest request) List
        +drafts(UUID jobId) List
        +editDraft() Map
    }
    class CareerToolsRepository {
        <<repository>>
        +insertApplicationDrafts() UUID
        +listApplicationDraftsById() List
    }
    class AiService {
        <<service>>
        +generate(String feature, Map input) Map
    }
    class ResumeService {
