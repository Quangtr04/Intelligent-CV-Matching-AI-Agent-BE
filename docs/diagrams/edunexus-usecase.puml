title EDUNEXUS · USE CASE CHUNG VÀ TÍCH HỢP
caption Xác thực · dùng thử · tài khoản · hỗ trợ · webhook thanh toán

actor "Khách" as actor_guest
actor "Người dùng\nđã đăng nhập" as actor_member
actor "SMTP / Mailtrap\n«hệ thống ngoài»" as actor_smtp
actor "Google Identity\n«hệ thống ngoài»" as actor_google
actor "AI provider\n«hệ thống ngoài»" as actor_ai
actor "Nguồn webhook\nthanh toán" as actor_payment

rectangle "Hệ thống EduNexus" as edunexus {
  rectangle "Xác thực, dùng thử và chức năng chung" as group_shared_main #EFF6FF {
    usecase "Đăng ký tài khoản" as uc_register
    usecase "Xác minh email bằng OTP" as uc_verify
    usecase "Gửi lại mã xác minh" as uc_resend
    usecase "Đăng nhập bằng email" as uc_email_login
    usecase "Đăng nhập bằng Google" as uc_google_login
    usecase "Dùng thử CV và gợi ý việc làm" as uc_trial
    usecase "Chat nghề nghiệp dùng thử" as uc_trial_chat
    usecase "Quản lý tài khoản / mật khẩu / phiên" as uc_account
    usecase "Xem gói, tạo đơn, xem hóa đơn" as uc_billing
    usecase "Xem / đánh dấu thông báo" as uc_notifications
    usecase "Tạo ticket và trao đổi hỗ trợ" as uc_support
  }
  usecase "Phát hành mã xác minh" as uc_issue_code
  usecase "Gửi mã qua SMTP" as uc_send_mail
  usecase "Xác minh Google ID token" as uc_google_check
  usecase "Sinh câu trả lời AI\ncho hội thoại dùng thử" as uc_trial_ai
  usecase "Tiếp nhận webhook thanh toán" as uc_webhook
  usecase "Kiểm tra chữ ký / timestamp\nvà đối chiếu đơn" as uc_signature
  usecase "Kích hoạt gói, tạo hóa đơn\nvà thông báo thanh toán" as uc_activate
}

actor_guest -- uc_register
actor_guest -- uc_verify
actor_guest -- uc_resend
actor_guest -- uc_email_login
actor_guest -- uc_google_login
actor_guest -- uc_trial
actor_guest -- uc_trial_chat
actor_member -- uc_account
actor_member -- uc_billing
actor_member -- uc_notifications
actor_member -- uc_support
uc_register .> uc_issue_code : <<include>>
uc_resend .> uc_issue_code : <<include>>
uc_send_mail .> uc_issue_code : <<extend>>
actor_smtp -- uc_send_mail
uc_google_login .> uc_google_check : <<include>>
actor_google -- uc_google_check
uc_trial_chat .> uc_trial_ai : <<include>>
actor_ai -- uc_trial_ai
actor_payment -- uc_webhook
uc_webhook .> uc_signature : <<include>>
uc_activate .> uc_webhook : <<extend>>\n[COMPLETED mới, đơn PENDING]

note "SMTP khi dev OTP=false và mail enabled=true.\nDev OTP=true trả code, bỏ qua gửi thư.\nResend: tài khoản tồn tại và còn PENDING." as note_1

note "Trial builder cần AI; recommendations dùng rule.\nTạo đơn chỉ tạo PENDING, chưa checkout.\nWebhook là hợp đồng adapter generic.\nWebhook lặp không tạo lại gói / hóa đơn." as note_2

note "Google dùng email bên thứ ba có thể cần OTP hệ thống. Webhook FAILED/CANCELLED không kích hoạt gói.\nĐường liên kết actor không có mũi tên; «include» trỏ tới hành vi bắt buộc, «extend» trỏ tới use case được mở rộng." as note_3
@enduml

