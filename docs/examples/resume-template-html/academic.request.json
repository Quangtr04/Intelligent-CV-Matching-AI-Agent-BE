{
  "name": "Học thuật – HTML",
  "careerPath": null,
  "language": "vi",
  "description": "Mẫu CV hai cột, thanh bên xanh navy và tiêu đề nền xám.",
  "active": true,
  "trialEnabled": false,
  "htmlContent": "<!DOCTYPE html>\n<html lang=\"vi\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Mẫu CV Học thuật</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;padding:0}body{font-family:Arial,sans-serif;background:#f1f3f5;color:#24303b;font-size:11pt;line-height:1.5}.sheet{display:flex;flex-direction:column;width:100%;max-width:210mm;min-height:297mm;margin:0 auto;background:#fff}h1,h2,h3,p{margin:0}h1{overflow-wrap:anywhere}h2{font-size:12pt;letter-spacing:1px;text-transform:uppercase;margin-bottom:4mm}.cv-section{margin-bottom:7mm}.cv-entry{margin-bottom:4mm;break-inside:avoid}.cv-entry-title{font-size:11pt;font-weight:bold}.cv-entry-subtitle{font-size:10pt}.cv-entry-period{font-size:9pt;color:#65717c;margin:1mm 0}.cv-entry-text{font-size:10pt;white-space:pre-wrap;overflow-wrap:anywhere}.cv-entry-items{padding-left:5mm;margin:2mm 0;font-size:10pt}.cv-entry-items li{margin-bottom:1mm}.contact{font-size:9pt;white-space:pre-wrap;overflow-wrap:anywhere}.headline{font-size:12pt;margin-top:3mm}.cv-section[hidden]{display:none}.cv-section:last-child,.cv-entry:last-child{margin-bottom:0}@page{size:A4;margin:0}@media print{body{background:#fff}.sheet{max-width:none;margin:0}h2{break-after:avoid}}\n.heading{background:#e9e9e9;padding:10mm 14mm 8mm;min-height:42mm}h1{font-size:29pt;line-height:1.12;color:#1a2a36}.columns{display:grid;grid-template-columns:69% 31%;flex:1;min-height:0}.main-column{padding:8mm 11mm 7mm 14mm}.cv-section{margin-bottom:5mm}h2{margin-bottom:3mm}.cv-entry{margin-bottom:3mm}.sidebar{background:#1a2a36;color:#fff;padding:10mm 6mm}.sidebar h2{color:#fff;font-size:11pt;border-bottom:1px solid #6b7a84;padding-bottom:3mm}.sidebar .contact{margin-bottom:9mm}.sidebar .cv-entry-period{color:#dae0e5}.main-column h2{color:#1a2a36;border-bottom:1px solid #ccd1d6;padding-bottom:2mm}@media(max-width:560px){.heading{padding:8mm}h1{font-size:24pt}.main-column{padding:7mm}.sidebar{padding:7mm 4mm}h2,.sidebar h2{font-size:10pt}.cv-entry-text,.cv-entry-title{font-size:9pt}}\n</style>\n</head>\n<body>\n<main class=\"sheet\">\n<header class=\"heading\"><h1 data-cv-field=\"fullName\">HỌ VÀ TÊN</h1><p class=\"headline\" data-cv-field=\"headline\">Vị trí hoặc định hướng nghề nghiệp</p></header>\n<div class=\"columns\">\n<div class=\"main-column\"><section class=\"cv-section\"><h2>Học vấn</h2><div data-cv-section=\"education\"><article class=\"cv-entry\"><p class=\"cv-entry-text\">Tên trường • Chuyên ngành • Thời gian học</p></article></div></section><section class=\"cv-section\"><h2>Kinh nghiệm</h2><div data-cv-section=\"experience\"><article class=\"cv-entry\"><p class=\"cv-entry-text\">Vai trò • Đơn vị • Công việc và kết quả đã thực hiện</p></article></div></section><section class=\"cv-section\"><h2>Dự án</h2><div data-cv-section=\"projects\"><article class=\"cv-entry\"><p class=\"cv-entry-text\">Tên dự án • Vai trò • Đóng góp thực tế</p></article></div></section><section class=\"cv-section\"><h2>Chứng chỉ</h2><div data-cv-section=\"certifications\"><article class=\"cv-entry\"><p class=\"cv-entry-text\">Tên chứng chỉ • Đơn vị cấp • Năm</p></article></div></section></div>\n<aside class=\"sidebar\"><section class=\"cv-section\"><h2>Liên hệ</h2><p class=\"contact\" data-cv-field=\"contact\">Email • Điện thoại • Địa chỉ</p></section><section class=\"cv-section\"><h2>Giới thiệu</h2><div data-cv-section=\"summary\"><article class=\"cv-entry\"><p class=\"cv-entry-text\">Mục tiêu nghề nghiệp và những điểm phù hợp của ứng viên</p></article></div></section><section class=\"cv-section\"><h2>Kỹ năng</h2><div data-cv-section=\"skills\"><article class=\"cv-entry\"><p class=\"cv-entry-text\">Các kỹ năng đã được xác nhận trong CV</p></article></div></section></aside>\n</div>\n</main>\n</body>\n</html>\n"
}
