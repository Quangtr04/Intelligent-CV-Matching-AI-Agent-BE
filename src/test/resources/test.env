REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=500ms
REDIS_CONNECT_TIMEOUT=500ms
REDIS_SSL_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_FRONTEND_RESET_URL=https://frontend.example.invalid/reset-password
APP_JWT_SECRET=
DEBUG=false
TRACE=false
AI_CHAT_PROVIDER=none
AI_EMBEDDING_PROVIDER=none
