AI_EMBEDDING_MODEL=qwen3-embedding:0.6b
AI_MAX_OUTPUT_TOKENS=2000
AI_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=5m
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_EMBEDDING_CONTEXT_LENGTH=8192
GOOGLE_CLIENT_ID=
