# Copy to .env for docker compose, replace placeholders, and export the app
# variables in your shell before starting Spring Boot (.env is not auto-loaded).
POSTGRES_DB=edunexus
POSTGRES_USER=edunexus
POSTGRES_PASSWORD=replace-with-local-database-password
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/edunexus

# Optional ATS cache: docker compose up -d --wait redis.
# Local Compose Redis has no authentication or TLS; credentials are for an external Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=500ms
REDIS_CONNECT_TIMEOUT=500ms
REDIS_SSL_ENABLED=false

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_JWT_SECRET=replace-with-a-long-random-jwt-signing-secret
DEBUG=false
TRACE=false
OPENAI_API_KEY=
AI_CHAT_PROVIDER=none
AI_EMBEDDING_PROVIDER=none
AI_CHAT_MODEL=gpt-4.1-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_OUTPUT_TOKENS=2000
AI_ENABLED=false
GOOGLE_CLIENT_ID=
PAYMENT_PROVIDER=MANUAL_GATEWAY
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-payment-webhook-secret
MAIL_ENABLED=false
MAIL_FROM=noreply@example.invalid
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
AUTH_EXPOSE_DEV_OTP=false
GUEST_TOKEN_LIMIT=5000
UPLOAD_DIR=./uploads
BILLING_MAINTENANCE_ENABLED=true

# Optional compose services: docker compose --profile optional up -d
RABBITMQ_USER=edunexus
RABBITMQ_PASSWORD=replace-with-local-rabbitmq-password
