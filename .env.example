# Copy to .env if absent, then replace credential placeholders.
# Spring Boot loads this UTF-8 file from its working directory; OS variables take precedence.
# Use unquoted KEY=value entries and forward slashes in paths. Put comments on separate lines.
# Default Spring profile is dev. Select prod/docker with SPRING_PROFILES_ACTIVE or --spring.profiles.active.
# Local Compose app selects docker; compose.production.yaml selects prod independently of this file.
POSTGRES_DB=edunexus
POSTGRES_USER=edunexus
POSTGRES_PASSWORD=replace-with-local-database-password
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/edunexus

# Local Compose app connects to host PostgreSQL at host.docker.internal:5432/edunexus.
# Start app + its healthy Redis dependency: docker compose --profile app --profile optional up -d --build app.
# Optional PostgreSQL container for host-run dev: docker compose --profile database up -d --wait postgres.
# App DATABASE_URL and Redis redis:6379/no-auth are set explicitly in compose.yaml.
# APP_PORT=8080

# Optional ATS cache: docker compose up -d --wait redis.
# Local Compose Redis has no authentication or TLS; credentials are for an external Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=500ms
REDIS_CONNECT_TIMEOUT=500ms
REDIS_SSL_ENABLED=false

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Required: generate 32+ cryptographically random bytes and encode as Base64 text.
# Used as UTF-8 text for HS256; blank, short, and known placeholders fail startup.
APP_JWT_SECRET=
DEBUG=false
TRACE=false
OPENAI_API_KEY=
AI_CHAT_PROVIDER=none
AI_EMBEDDING_PROVIDER=none
AI_CHAT_MODEL=gpt-4.1-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_OUTPUT_TOKENS=2000
AI_ENABLED=false
GOOGLE_CLIENT_ID=
PAYMENT_PROVIDER=MANUAL_GATEWAY
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-payment-webhook-secret
MAIL_ENABLED=true
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-sandbox-username
MAIL_PASSWORD=your-sandbox-password
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=noreply@edunexus.test
AUTH_EXPOSE_DEV_OTP=false
# The prod profile keeps development OTP responses disabled regardless of AUTH_EXPOSE_DEV_OTP.
GUEST_TOKEN_LIMIT=5000
UPLOAD_DIR=./uploads
BILLING_MAINTENANCE_ENABLED=true

# Optional compose services: docker compose --profile optional up -d
RABBITMQ_USER=edunexus
RABBITMQ_PASSWORD=replace-with-local-rabbitmq-password

# Application and framework settings
SPRING_APPLICATION_NAME=INTELLIGENT_CV_MATCHING_AI_AGENT
SERVER_PORT=8080
SCHEDULING_POOL_SIZE=3
JPA_DDL_AUTO=none
JPA_OPEN_IN_VIEW=false
DOCKER_COMPOSE_ENABLED=false
BATCH_JOB_ENABLED=false
BATCH_SCHEMA_INITIALIZATION=never
SESSION_STORE_TYPE=none
REDIS_REPOSITORIES_ENABLED=false
MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=11MB
SPRING_AUTOCONFIGURE_EXCLUDE=org.springframework.ai.vectorstore.qdrant.autoconfigure.QdrantVectorStoreAutoConfiguration,org.springframework.boot.session.data.redis.autoconfigure.SessionDataRedisAutoConfiguration

# SMTP timeouts in milliseconds
MAIL_CONNECTION_TIMEOUT=5000
MAIL_TIMEOUT=5000

# AI adapters and model settings
AI_PROVIDER=openai
AI_SPEECH_PROVIDER=none
AI_TRANSCRIPTION_PROVIDER=none
AI_IMAGE_PROVIDER=none
AI_MODERATION_PROVIDER=none
AI_CHAT_TEMPERATURE=0.2
AI_EMBEDDING_DIMENSIONS=1536
QDRANT_VECTORSTORE_ENABLED=false

# OCR settings; use forward slashes in Windows paths
APP_OCR_ENABLED=false
APP_OCR_TESSDATA=
APP_OCR_LANGUAGE=eng+vie

# Health, error responses, and logging
# Profiles provide defaults; these values explicitly override dev/docker defaults.
# prod always hides error details/stack traces and health details.
MANAGEMENT_ENDPOINTS_EXPOSURE=health,info
HEALTH_SHOW_DETAILS=never
HEALTH_PROBES_ENABLED=true
HEALTH_REDIS_ENABLED=false
HEALTH_RABBIT_ENABLED=false
HEALTH_MAIL_ENABLED=false
SERVER_ERROR_INCLUDE_MESSAGE=never
SERVER_ERROR_INCLUDE_STACKTRACE=never
LOG_WEB_LEVEL=INFO
LOG_SQL_LEVEL=INFO
LOG_SPRING_WEB_LEVEL=INFO
LOG_SPRING_JDBC_LEVEL=INFO

# Scheduled job collection and expiration
JOB_COLLECTION_ENABLED=false
JOB_COLLECTION_ACTOR_ID=
JOB_COLLECTION_FIXED_DELAY=PT6H
JOB_COLLECTION_ITVIEC_SOURCE_SITE=ITVIEC
JOB_COLLECTION_ITVIEC_KEYWORD=Java
JOB_COLLECTION_ITVIEC_ROLE=Backend
# Empty JOB_COLLECTION_*_LOCATION searches nationwide; set a city to narrow it.
JOB_COLLECTION_ITVIEC_LOCATION=
JOB_COLLECTION_TOPCV_SOURCE_SITE=TOPCV
JOB_COLLECTION_TOPCV_KEYWORD=Java
JOB_COLLECTION_TOPCV_ROLE=Backend
JOB_COLLECTION_TOPCV_LOCATION=
JOB_COLLECTION_LIMIT=20
JOB_COLLECTION_MAX_PAGES=3
JOB_EXPIRATION_ENABLED=true
JOB_EXPIRATION_FIXED_DELAY=PT15M
JOB_EXPIRATION_BATCH_SIZE=500

# Job embedding worker
JOB_EMBEDDING_ENABLED=true
JOB_EMBEDDING_BATCH_SIZE=10
JOB_EMBEDDING_FIXED_DELAY_MS=30000
JOB_EMBEDDING_INITIAL_DELAY_MS=10000
JOB_EMBEDDING_LEASE_SECONDS=300
JOB_EMBEDDING_RETRY_SECONDS=30

# Billing maintenance
BILLING_MAINTENANCE_BATCH_SIZE=500
BILLING_MAINTENANCE_ZONE=Asia/Ho_Chi_Minh
